# Checkout of the private benchmark repo, benkarlsberg/verified-repair-agent-private.
# The default is a gitignored ./private directory next to this project.
REPAIR_AGENT_PRIVATE_DIR=private

# Read only by repair-agent run and repair-agent evaluate when --model openai
# (the default). validate-cases, freeze, --model fake, and the replay viewer
# do not read it. Never commit a real key.
# OPENAI_API_KEY=
